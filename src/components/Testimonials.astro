---
import Icon from "./Icon.astro";
import Heading from "./Heading.astro";
import { business, testimonials } from "../lib/salon";
---

<section id="opinie" class="px-4 py-24 sm:px-6 sm:py-32">
  <div class="mx-auto max-w-[1180px]">
    <div class="flex flex-col items-center gap-6 text-center">
      <Heading kicker="Opinie" align="center">
        Pokochały nas <span class="italic text-moss">klientki.</span>
      </Heading>
      <div
        class="reveal inline-flex items-center gap-3 rounded-full bg-sage-pale px-5 py-2.5"
      >
        <span class="flex text-moss">
          {
            Array.from({ length: 5 }).map(() => (
              <Icon name="star" class="h-4 w-4" />
            ))
          }
        </span>
        <span class="text-[13px] font-medium text-pine">
          {business.rating} · {business.reviews} opinii · Booksy
        </span>
      </div>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <blockquote
            class:list={[
              "reveal flex flex-col justify-between rounded-[1.75rem] p-8",
              i === 0
                ? "bg-forest text-sage-mist sm:col-span-2 lg:col-span-1 lg:row-span-2"
                : "bg-cream ring-1 ring-forest/8",
            ]}
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <p
              class:list={[
                "font-cormorant leading-snug font-medium",
                i === 0
                  ? "text-[30px] text-sage-mist"
                  : "text-[24px] text-forest",
              ]}
            >
              „{t.quote}"
            </p>
            <footer class="mt-6 flex items-center gap-3">
              <span
                class:list={[
                  "grid h-10 w-10 place-items-center rounded-full font-cormorant text-lg",
                  i === 0
                    ? "bg-sage-mist/15 text-sage-soft"
                    : "bg-sage-pale text-moss",
                ]}
              >
                {t.name.charAt(0)}
              </span>
              <span
                class:list={[
                  "text-[14px] font-medium",
                  i === 0 ? "text-sage-mist" : "text-forest",
                ]}
              >
                {t.name}
              </span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
