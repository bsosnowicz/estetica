---
import Icon from "./Icon.astro";
import Heading from "./Heading.astro";
import { business, serviceCategories } from "../lib/salon";

const serviceIcons = [
  "nails",
  "brow",
  "face",
  "syringe",
  "laser",
  "lotus",
  "body",
] as const;
---

<section id="uslugi" class="px-4 py-8 sm:px-6">
  <div
    class="mx-auto max-w-[1180px] rounded-[3rem] bg-sage-mist px-5 py-20 sm:px-12 sm:py-24"
  >
    <div class="flex flex-col items-center gap-5 text-center">
      <Heading
        kicker="Usługi"
        intro="Ponad 200 zabiegów w 23 kategoriach. Poniżej reprezentatywny wybór — pełny, aktualny cennik prowadzimy na Booksy."
        align="center"
      >
        Zabiegi dopasowane
        <br />
        <span class="italic text-moss">do Twojej skóry.</span>
      </Heading>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        serviceCategories.map((cat, i) => {
          const iconName = serviceIcons[i % serviceIcons.length];
          const featured = i === 3;
          return (
            <article
              class:list={[
                "reveal flex flex-col rounded-[1.75rem] p-7 transition-all duration-400",
                featured
                  ? "bg-forest ring-1 ring-forest"
                  : "bg-cream ring-1 ring-forest/8 hover:ring-forest/20",
              ]}
              style={`--reveal-delay: ${(i % 3) * 60}ms`}
            >
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    "grid h-11 w-11 place-items-center rounded-full",
                    featured
                      ? "bg-sage-mist/12 text-sage-soft"
                      : "bg-sage-pale text-moss",
                  ]}
                >
                  <Icon name={iconName} class="h-5 w-5" />
                </span>
                <span
                  class:list={[
                    "text-[12px] font-semibold tracking-widest",
                    featured ? "text-sage-mist/45" : "text-sage",
                  ]}
                >
                  {cat.index}
                </span>
              </div>

              <h3
                class:list={[
                  "mt-5 font-cormorant text-[28px] leading-tight font-medium",
                  featured ? "text-sage-mist" : "text-forest",
                ]}
              >
                {cat.title}
              </h3>
              <p
                class:list={[
                  "mt-2.5 text-[13.5px] leading-relaxed",
                  featured ? "text-sage-mist/70" : "text-moss",
                ]}
              >
                {cat.blurb}
              </p>

              <ul
                class:list={[
                  "mt-6 flex-1 space-y-3 border-t pt-6",
                  featured ? "border-sage-mist/15" : "border-forest/10",
                ]}
              >
                {cat.items.map((it) => (
                  <li class="flex items-baseline justify-between gap-4">
                    <span
                      class:list={[
                        "text-[13.5px] leading-snug",
                        featured ? "text-sage-mist/85" : "text-pine/90",
                      ]}
                    >
                      {it.name}
                    </span>
                    <span
                      class:list={[
                        "shrink-0 text-[13px] font-medium tabular-nums",
                        featured ? "text-sage-soft" : "text-moss",
                      ]}
                    >
                      {it.price}
                    </span>
                  </li>
                ))}
              </ul>

              <a
                href={business.links.booking}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "group mt-7 inline-flex items-center gap-2 text-[13px] font-medium transition-colors",
                  featured
                    ? "text-sage-soft hover:text-sage-mist"
                    : "text-forest hover:text-moss",
                ]}
              >
                Pełny cennik
                <Icon
                  name="arrow-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                />
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
