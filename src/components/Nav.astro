---
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";
import { navLinks } from "../lib/salon";
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <div
    id="nav-bar"
    class="mx-auto flex max-w-[1180px] items-center justify-between rounded-full py-2.5 pr-2.5 pl-6 transition-all duration-500 bg-transparent"
  >
    <a
      href="#top"
      class="flex items-center gap-2 font-cormorant text-[26px] leading-none font-semibold text-forest"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-full bg-forest text-sage-mist"
      >
        <Icon name="leaf" class="h-4 w-4" />
      </span>
      Estetica
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="text-[14px] font-medium text-pine/80 transition-colors hover:text-forest"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <Pill withArrow={false} class="px-6 py-3 text-[13px]" />
      </div>
      <button
        type="button"
        id="nav-open"
        class="grid h-11 w-11 place-items-center rounded-full text-forest ring-1 ring-inset ring-forest/15 lg:hidden"
        aria-label="Otwórz menu"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  {/* Mobile drawer */}
  <div
    id="nav-drawer"
    class="fixed inset-0 z-50 lg:hidden pointer-events-none"
    aria-hidden="true"
  >
    <div
      id="nav-overlay"
      class="absolute inset-0 bg-forest/40 backdrop-blur-sm transition-opacity duration-300 opacity-0"
    >
    </div>
    <div
      id="nav-panel"
      class="absolute top-0 right-0 flex h-full w-[82%] max-w-sm flex-col bg-cream px-7 py-6 shadow-2xl transition-transform duration-400 translate-x-full"
      style="transition-timing-function: var(--ease-out-soft)"
    >
      <div class="flex items-center justify-between">
        <span class="font-cormorant text-[26px] font-semibold text-forest">
          Estetica
        </span>
        <button
          type="button"
          id="nav-close"
          class="grid h-11 w-11 place-items-center rounded-full ring-1 ring-inset ring-forest/15"
          aria-label="Zamknij menu"
        >
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>
      <nav class="mt-10 flex flex-col gap-1" id="nav-drawer-links">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="border-b border-forest/10 py-4 font-cormorant text-3xl font-medium text-forest"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
      <div class="mt-auto pt-8">
        <Pill class="w-full" />
      </div>
    </div>
  </div>
</header>

<script>
  const SCROLLED = [
    "bg-cream/85",
    "shadow-[0_10px_40px_-24px_rgba(44,53,42,0.5)]",
    "ring-1",
    "ring-forest/10",
    "backdrop-blur-md",
  ];

  const bar = document.getElementById("nav-bar")!;
  const onScroll = () => {
    if (window.scrollY > 16) {
      bar.classList.remove("bg-transparent");
      bar.classList.add(...SCROLLED);
    } else {
      bar.classList.add("bg-transparent");
      bar.classList.remove(...SCROLLED);
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const drawer = document.getElementById("nav-drawer")!;
  const overlay = document.getElementById("nav-overlay")!;
  const panel = document.getElementById("nav-panel")!;

  const setOpen = (open: boolean) => {
    drawer.classList.toggle("pointer-events-none", !open);
    drawer.setAttribute("aria-hidden", String(!open));
    overlay.classList.toggle("opacity-100", open);
    overlay.classList.toggle("opacity-0", !open);
    panel.classList.toggle("translate-x-0", open);
    panel.classList.toggle("translate-x-full", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  document
    .getElementById("nav-open")!
    .addEventListener("click", () => setOpen(true));
  document
    .getElementById("nav-close")!
    .addEventListener("click", () => setOpen(false));
  overlay.addEventListener("click", () => setOpen(false));
  document
    .getElementById("nav-drawer-links")!
    .querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
