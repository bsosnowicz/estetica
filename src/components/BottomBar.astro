---
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";
import { business } from "../lib/salon";
---

<div
  id="bottom-bar"
  class="fixed inset-x-0 bottom-4 z-40 flex justify-center px-4 transition-all duration-500 pointer-events-none translate-y-6 opacity-0"
>
  <div
    class="flex w-full max-w-[1180px] items-center justify-between gap-4 rounded-full bg-forest/95 py-2.5 pr-2.5 pl-6 shadow-[0_20px_50px_-20px_rgba(44,53,42,0.7)] backdrop-blur-md"
  >
    <div class="flex min-w-0 items-center gap-3">
      <span
        class="hidden h-9 w-9 shrink-0 place-items-center rounded-full bg-sage-mist/15 text-sage-mist sm:grid"
      >
        <Icon name="star" class="h-4 w-4 text-sage-soft" />
      </span>
      <div class="min-w-0 leading-tight">
        <div class="truncate font-cormorant text-lg text-sage-mist">
          Gotowa na wizytę w Estetice?
        </div>
        <div class="truncate text-[12px] text-sage-mist/60">
          {business.rating} ★ · {business.reviews} opinii · Katowice
        </div>
      </div>
    </div>
    <Pill variant="cream" class="shrink-0 px-6 py-3 text-[13px]" />
  </div>
</div>

<script>
  const bar = document.getElementById("bottom-bar")!;
  const HIDDEN = ["pointer-events-none", "translate-y-6", "opacity-0"];
  const SHOWN = ["translate-y-0", "opacity-100"];

  const onScroll = () => {
    const y = window.scrollY;
    const nearBottom =
      y + window.innerHeight > document.body.scrollHeight - 260;
    const show = y > 640 && !nearBottom;
    HIDDEN.forEach((c) => bar.classList.toggle(c, !show));
    SHOWN.forEach((c) => bar.classList.toggle(c, show));
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
